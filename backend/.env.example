# ── App Settings ─────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./trademind.db
SECRET_KEY=CHANGE-THIS-TO-A-STRONG-RANDOM-SECRET-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Email Digest (optional) ───────────────────────────────────────────
# Get a Gmail App Password: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
FROM_EMAIL=your.email@gmail.com
FROM_NAME=TradeMind OS

# ── AI Coach (Gemini API) ──────────────────────────────────────────
# Get a free Gemini API key: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
